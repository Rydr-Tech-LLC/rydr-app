# Vercel builds the public website and Mission Control from this repository.
# Mission Control also imports shared policies from the backend source tree.
/*
!/RydrMissionControl
!/Rydr_Website
!/rydr-backend
**/.DS_Store
**/node_modules/**
**/.env*
**/.git/**
**/*.p8
**/*.pem
**/*.log
RydrMissionControl/node_modules/**
RydrMissionControl/.next/**
RydrMissionControl/.vercel/**
RydrMissionControl/.env*
RydrMissionControl/*.tsbuildinfo
