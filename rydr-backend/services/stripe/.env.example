PORT=10000
APP_BASE_URL=

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Keep both active keys in test mode during preparation. To launch later,
# replace these two keys together with their live equivalents and redeploy.
# /config supplies the public key to apps; restart apps after a mode cutover.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Existing unsuffixed values remain test-only fallbacks.
STRIPE_WEBHOOK_SECRET=
STRIPE_DRIVER_VERIFICATION_FLOW_ID=
STRIPE_RIDER_VERIFICATION_FLOW_ID=

# Preconfigure each endpoint's own whsec_ signing secret securely in Render.
# Platform scope -> /webhook: payment_intent.succeeded/payment_failed,
# setup_intent.succeeded, identity.verification_session.verified/processing/
# requires_input/canceled.
# Connected accounts scope -> /webhook/connect: account.updated,
# account.external_account.created/updated/deleted,
# payout.created/updated/paid/failed/canceled.
# Snapshot API versions supported: 2024-06-20 and 2025-05-28.basil.
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_CONNECT_WEBHOOK_SECRET_TEST=
STRIPE_DRIVER_VERIFICATION_FLOW_ID_TEST=
STRIPE_RIDER_VERIFICATION_FLOW_ID_TEST=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_CONNECT_WEBHOOK_SECRET_LIVE=
STRIPE_DRIVER_VERIFICATION_FLOW_ID_LIVE=
STRIPE_RIDER_VERIFICATION_FLOW_ID_LIVE=

# Deploy this backend before the mode-aware weekly payout functions.
# GET /internal/stripe-mode (internal token header) reports active readiness
# and missing live configuration names without disclosing credentials.
# Live onboarding creates new accounts/customers/payment methods; test IDs,
# balances and verification results are preserved separately, never reused.
# Untagged rides predating live activation cannot be charged in live mode.
# Stripe's live Instant Payout eligibility/limit must be approved separately.
# The updated in-app Driver wallet release must already be installed.

# Shared only with the Firebase payment/payout-job functions.
RYDR_INTERNAL_SERVICE_TOKEN=

# Shared only with Mission Control's server-side account-deletion routes.
RYDR_INTERNAL_ADMIN_SECRET=
