PORT=8080
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase.json
CORS_ORIGINS=https://www.rydr-go.com,https://rydr-go.com

# High-entropy secret shared only with the trusted web-booking backend that
# signs short-lived RydrBank preview/consume authorizations.
RYDR_WEB_BOOKING_SECRET=

# Optional outbound gift notifications. The service safely skips the related
# channel when its provider configuration is absent.
SENDGRID_API_KEY=
EMAIL_FROM=support@rydr-go.com
EMAIL_FROM_NAME=Rydr Support
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
